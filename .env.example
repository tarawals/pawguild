# Copy to apps/api/.env (or export in your shell). Never commit real credentials.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Application connection: a NON-owner, NON-superuser role so row-level security applies.
DATABASE_URL=postgres://pawguild_app:pawguild_app@localhost:5432/pawguild_dev
# Schema-owner connection used only by migrations and the seed script.
MIGRATION_DATABASE_URL=postgres://pawguild:pawguild@localhost:5432/pawguild_dev
APP_DB_ROLE=pawguild_app
SESSION_TTL_HOURS=12
# Set to true whenever the app is served over HTTPS.
COOKIE_SECURE=false
# Password for demo seed users (development only).
SEED_PASSWORD=pawguild-demo
