{
  "name": "@pawguild/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "dotenv -e .env -- tsx src/db/migrate.ts",
    "db:seed": "dotenv -e .env -- tsx src/db/seed.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@pawguild/shared": "^0.1.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
