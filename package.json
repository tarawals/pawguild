{
  "name": "pawguild",
  "private": true,
  "type": "module",
  "description": "PawGuild — the operating platform for pet-care businesses",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @pawguild/api",
    "dev:web": "npm run dev -w @pawguild/web",
    "db:migrate": "npm run db:migrate -w @pawguild/api",
    "db:seed": "npm run db:seed -w @pawguild/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
